# Version 1.0, 2026-10-30, dominik@hudzik.info
# Sway config for a laptop with one external monitor (Debian 13, Sway 1.10).
# Reload after edits: Mod+Shift+c.  Full reference: man 5 sway
# Helper scripts live in ~/.local/bin (see ../bin). Sway's PATH has no ~/.local/bin, so every call uses the full path.

### Basics
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel
set $lock swaylock -f -c 1e1e2e

font pango:Noto Sans 10.5
default_border pixel 2
default_floating_border normal
gaps inner 4
focus_follows_mouse no

### Monitors (Wayland names; check with: swaymsg -t get_outputs)
# External monitor on HDMI. If the bottom of the screen jumps sideways again,
# swap the mode line for the 50 Hz one below (needs fewer MHz on HDMI).
output HDMI-A-1 mode 2560x1440@59.951Hz position 0 0
# output HDMI-A-1 mode --custom 2560x1440@50Hz position 0 0
# Same monitor over a USB-C cable (port name may be DP-1 or DP-2).
output DP-1 mode 2560x1440@59.951Hz position 0 0
output DP-2 mode 2560x1440@59.951Hz position 0 0
# Laptop panel: only used when no external monitor is connected (sway-outputs
# follows hotplug), and off while the lid is closed.
output eDP-1 mode 1920x1080@60Hz position 0 0
bindswitch --locked lid:on output eDP-1 disable
bindswitch --locked lid:off exec ~/.local/bin/sway-outputs
exec_always ~/.local/bin/sway-outputs daemon
# Freeze processes of windows on workspace 9 while it is hidden.
exec_always ~/.local/bin/sway-freeze

# Daily wallpaper from a folder (see bin/wallpaper-daily). No `output * bg ...` line here on purpose:
# a reload would re-apply it and wipe today's picture, because the script sets one only once a day.
exec_always ~/.local/bin/wallpaper-daily
# Evening colour warmth: set YOUR latitude / longitude
exec_always sh -c 'pkill -x wlsunset; exec wlsunset -l 52.0 -L 13.0'

# Catppuccin Mocha window borders
client.focused          #b4befe #1e1e2e #cdd6f4 #f5e0dc #b4befe
client.focused_inactive #6c7086 #1e1e2e #cdd6f4 #6c7086 #6c7086
client.unfocused        #313244 #1e1e2e #a6adc8 #313244 #313244
client.urgent           #fab387 #1e1e2e #fab387 #fab387 #fab387

### Keyboard, mouse, touchscreen
input type:keyboard {
    xkb_layout us
    xkb_options terminate:ctrl_alt_bksp
    repeat_delay 300
    repeat_rate 35
}
input type:touchpad {
    tap enabled
    natural_scroll disabled
    dwt enabled
}
# Touchscreen follows the laptop panel, not the big monitor.
input type:touch map_to_output eDP-1

### Idle: screens off after 10 min (no auto lock; Ctrl+Alt+l locks by hand)
