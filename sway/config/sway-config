### Autostart (what XFCE started for you)
exec /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec /usr/bin/gnome-keyring-daemon --start --components=secrets
exec nm-applet --indicator
exec blueman-applet
exec mako
# Clipboard history (replaces Clipman): text and images, picked with Ctrl+Alt+v
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
# Screen sharing in Vivaldi/Firefox (xdg-desktop-portal-wlr) needs these.
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

### Apps
bindsym $mod+Return exec $term
bindsym $mod+Shift+f exec firefox --new-window
bindsym $mod+b exec ~/.local/bin/sway-launcher --exact
bindsym $mod+v exec ~/.local/bin/sway-launcher --exact --recent
bindsym $mod+n exec thunar
# Wi-Fi: pick a network in a small floating terminal (nmtui)
bindsym $mod+Shift+w exec $term --title=wifi sh -c "nmcli dev wifi rescan; sleep 3; nmtui-connect"
for_window [title="^wifi$"] floating enable, resize set 700 500
bindsym $mod+Shift+q kill
# No confirmation. Ctrl+Shift+q is also Quit in Firefox/Chromium: the compositor takes it first.
bindsym Ctrl+Shift+q exec ~/.local/bin/sway-close-others
bindsym $mod+Shift+n exec ~/.local/bin/ws-new
bindsym $mod+Shift+s exec ~/.local/bin/sway-save
bindsym Ctrl+Alt+l exec $lock
bindsym Ctrl+Alt+v exec cliphist list | fuzzel --dmenu --width 70 | cliphist decode | wl-copy
bindsym Ctrl+Alt+Shift+v exec cliphist list | fuzzel --dmenu --width 70 --prompt 'delete> ' | cliphist delete

# Screenshots (saved to ~/Pictures, also copied to the clipboard)
bindsym Print exec grim ~/Pictures/shot-$(date +%F-%H%M%S).png
bindsym Shift+Print exec grim -g "$(slurp)" - | tee ~/Pictures/shot-$(date +%F-%H%M%S).png | wl-copy -t image/png

# Volume, brightness, media keys
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

### Session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Log out of Sway?' -B 'Yes, log out' 'swaymsg exit'
floating_modifier $mod normal

### Moving around (vim keys, arrows also work)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
# Mod+arrows switch workspace: Left/Right = previous/next, Up = first, Down = last. Focus stays on Mod+h j k l.
bindsym $mod+Left workspace prev
bindsym $mod+Right workspace next
bindsym $mod+Up exec ~/.local/bin/ws-edge first
bindsym $mod+Down exec ~/.local/bin/ws-edge last

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Workspaces
### Workspace names : the number stays first, so "workspace number N" and scripts that match by number keep working
set $ws1 "1: main"
set $ws2 "2: web"
set $ws3 "3: work"
set $ws4 "4: dev"
set $ws5 "5: docs"
set $ws6 "6"
set $ws7 "7: mail"
set $ws8 "8: media"
set $ws9 "9"
set $ws10 "10"
bindsym $mod+1 workspace number $ws1; exec ~/.local/bin/ws-open 1
bindsym $mod+2 workspace number $ws2; exec ~/.local/bin/ws-open 2
bindsym $mod+3 workspace number $ws3; exec ~/.local/bin/ws-open 3
bindsym $mod+4 workspace number $ws4; exec ~/.local/bin/ws-open 4
bindsym $mod+5 workspace number $ws5; exec ~/.local/bin/ws-open 5
bindsym $mod+6 workspace number $ws6; exec ~/.local/bin/ws-open 6
bindsym $mod+7 workspace number $ws7; exec ~/.local/bin/ws-open 7
bindsym $mod+8 workspace number $ws8; exec ~/.local/bin/ws-open 8
bindsym $mod+9 workspace number $ws9; exec ~/.local/bin/ws-open 9
bindsym $mod+0 workspace number $ws10; exec ~/.local/bin/ws-open 10
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Ctrl+Left workspace prev
bindsym $mod+Ctrl+Right workspace next
exec ~/.local/bin/sway-mru daemon
bindsym Mod1+Tab exec ~/.local/bin/sway-mru switch
bindsym Mod1+Shift+Tab exec ~/.local/bin/sway-windows
bindsym $mod+Shift+Tab exec ~/.local/bin/sway-windows
bindsym $mod+Shift+ISO_Left_Tab exec ~/.local/bin/sway-windows
bindsym Mod1+Shift+ISO_Left_Tab exec ~/.local/bin/sway-windows



### Layout
bindsym $mod+Ctrl+v splitv
bindsym $mod+Shift+v splith
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e exec ~/.local/bin/sway-flip
bindsym $mod+f fullscreen
bindsym $mod+Shift+space exec ~/.local/bin/sway-float
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Dialogs and pop-ups float
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [app_id="pavucontrol"] floating enable

### Scratchpad: a hidden window you can pop up anywhere
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Resize mode (Mod+r, then h j k l, Esc to leave)
mode "resize" {
    bindsym $left resize shrink width 20px
    bindsym $down resize grow height 20px
    bindsym $up resize shrink height 20px
    bindsym $right resize grow width 20px
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Status bar: waybar (config in ~/.config/waybar)
exec_always sh -c 'pkill -x waybar; exec waybar'

include /etc/sway/config.d/*

exec ~/.local/bin/sway-startup

bindsym $mod+x exec ~/.local/bin/sway-swap


# autotiling: alternates split direction for new windows. `exec`, not exec_always: a reload would start a second copy.
exec autotiling
