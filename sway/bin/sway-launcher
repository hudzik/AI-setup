#!/usr/bin/env python3
# Version 1.1, 2026-11-25, dominik@hudzik.info
"""App launcher for Sway: fuzzel list ordered by last launch (most recent first)."""
import configparser
import glob
import os
import re
import subprocess
import sys

MODE = ["--match-mode=exact"] if "--exact" in sys.argv else []
RECENT_ONLY = "--recent" in sys.argv  # only apps started with this launcher, last started first
HOME = os.path.expanduser("~")
RECENT = os.path.join(HOME, ".cache", "sway-launcher-recent")
DIRS = [f"{HOME}/.local/share/applications", "/usr/share/applications",
        f"{HOME}/.local/share/flatpak/exports/share/applications",
        "/var/lib/flatpak/exports/share/applications"]

apps = {}
for d in DIRS:
    for path in sorted(glob.glob(d + "/*.desktop")):
        app_id = os.path.basename(path)
        if app_id in apps:
            continue
        cp = configparser.RawConfigParser(strict=False, interpolation=None)
        try:
            cp.read(path, encoding="utf-8")
            e = cp["Desktop Entry"]
        except (OSError, UnicodeDecodeError, KeyError, configparser.Error):
            continue
        if e.get("Type") != "Application" or e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
            continue
        if "Exec" not in e or "Name" not in e:
            continue
        apps[app_id] = (e["Name"], e["Exec"], e.get("Terminal") == "true")

try:
    with open(RECENT) as fh:
        recent = [l.strip() for l in fh if l.strip()]
except OSError:
    recent = []
order = [i for i in recent if i in apps]
if not RECENT_ONLY:
    order += sorted((i for i in apps if i not in recent), key=lambda i: apps[i][0].lower())

lines = [f"{apps[i][0]}\t{i}" for i in order]
sel = subprocess.run(["fuzzel", "--dmenu", "--no-sort", *MODE, "--width", "50", "--with-nth=1", "--accept-nth=2", "--prompt", "run> "],
                     input="\n".join(lines), capture_output=True, text=True, check=False).stdout.strip()
if sel in apps:
    _, exec_line, term = apps[sel]
    cmd = re.sub(r"%[a-zA-Z%]", "", exec_line).strip()
    if term:
        cmd = f"foot -e {cmd}"
    with open(RECENT, "w") as f:
        f.write("\n".join([sel] + [i for i in recent if i != sel][:50]) + "\n")
    subprocess.run(["swaymsg", "exec", "--", cmd], check=False, stdout=subprocess.DEVNULL)
