#!/usr/bin/env python3
# Version 1.0, 2026-10-30, dominik@hudzik.info
"""Freeze (SIGSTOP) every process behind windows on Sway workspace 9 while it is not visible.
Wakes them (SIGCONT) when workspace 9 is shown, the window leaves it, or this script stops.
Windows whose process also owns a window elsewhere (e.g. one Vivaldi, two windows) are not frozen."""
import json, os, signal, subprocess, sys, time

WS = 9
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sway-freeze.json")

def swaymsg(*a):
    return json.loads(subprocess.check_output(["swaymsg", "-r", *a]))

def start_time(pid):
    try:
        return open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[19]
    except OSError:
        return None

def children_map():
    m = {}
    for d in os.listdir("/proc"):
        if d.isdigit():
            try:
                ppid = int(open(f"/proc/{d}/stat").read().rsplit(")", 1)[1].split()[1])
            except OSError:
                continue
            m.setdefault(ppid, []).append(int(d))
    return m

def tree_of(pid, cm):
    out, todo = set(), [pid]
    while todo:
        p = todo.pop()
        if p not in out:
            out.add(p)
            todo += cm.get(p, [])
    return out

def windows(node, ws=None, acc=None):
    acc = [] if acc is None else acc
    if node.get("type") == "workspace":
        ws = node.get("num")
    if node.get("pid") and node.get("type") in ("con", "floating_con") and not node.get("nodes"):
        acc.append((ws, node["pid"]))
    for k in ("nodes", "floating_nodes"):
        for n in node.get(k, []):
            windows(n, ws, acc)
    return acc

def load():
    try:
        return {int(k): v for k, v in json.load(open(STATE)).items()}
    except (OSError, ValueError):
        return {}

def save(frozen):
    json.dump(frozen, open(STATE, "w"))

def sig(pid, s):
    try:
        os.kill(pid, s)
    except OSError:
        pass

def wake(frozen, keep=()):
    for pid in list(frozen):
        if pid not in keep:
            if start_time(pid) == frozen[pid]:
                sig(pid, signal.SIGCONT)
            del frozen[pid]

def apply(frozen):
    visible = any(w["num"] == WS and w["visible"] for w in swaymsg("-t", "get_workspaces"))
    wins = windows(swaymsg("-t", "get_tree"))
    elsewhere = {pid for ws, pid in wins if ws != WS}
    want = set()
    if not visible:
        cm = children_map()
        for ws, pid in wins:
            sub = tree_of(pid, cm)
            if ws == WS and not (sub & elsewhere):
                want |= sub
        want.discard(os.getpid())
        want.discard(os.getppid())
    wake(frozen, keep=want)
    for pid in want:
        if pid not in frozen:
            st = start_time(pid)
            if st:
                sig(pid, signal.SIGSTOP)
                frozen[pid] = st
    save(frozen)

def main():
    frozen = load()
    wake(frozen)
    def bye(*_):
        wake(frozen); save(frozen); sys.exit(0)
    signal.signal(signal.SIGTERM, bye); signal.signal(signal.SIGINT, bye)
    pidf = STATE + ".pid"
    try:
        os.kill(int(open(pidf).read()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    time.sleep(0.5)
    open(pidf, "w").write(str(os.getpid()))
    apply(frozen)
    p = subprocess.Popen(["swaymsg", "-t", "subscribe", "-m", '["window","workspace"]'],
                         stdout=subprocess.PIPE, text=True)
    try:
        for _ in p.stdout:
            apply(frozen)
    finally:
        wake(frozen); save(frozen)

main()
